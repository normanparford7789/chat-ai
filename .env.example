# ============================================
# ردّآلي - متغيرات البيئة
# انسخ هذا الملف إلى .env واملأ القيم
# ============================================

# --- Supabase (مطلوب) ---
# رابط مشروع Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
# المفتاح العام (anon key)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- مفاتيح الذكاء الصناعي (اختر واحدًا أو أكثر) ---
# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx
# OpenRouter
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
# Hugging Face
HUGGINGFACE_API_KEY=hf_xxxxxxxxxxxxxxxxxxxx

# --- إعدادات التطبيق ---
# منفذ التشغيل
PORT=3000
# عنوان الموقع
VITE_APP_URL=http://localhost:3000

# --- واتساب Business API (اختياري) ---
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- فيسبوك ماسنجر (اختياري) ---
MESSENGER_ACCESS_TOKEN=
MESSENGER_VERIFY_TOKEN=
MESSENGER_APP_SECRET=

# --- إنستغرام (اختياري) ---
INSTAGRAM_ACCESS_TOKEN=

# --- تلغرام (اختياري) ---
TELEGRAM_BOT_TOKEN=

# --- تيك توك (اختياري) ---
TIKTOK_ACCESS_TOKEN=

# --- Google Business (اختياري) ---
GOOGLE_BUSINESS_API_KEY=

# --- البريد الإلكتروني (اختياري) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- SMS (اختياري) ---
SMS_PROVIDER=twilio
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# --- إعدادات الأمان ---
JWT_SECRET=your-jwt-secret-here
ENCRYPTION_KEY=your-encryption-key-here
